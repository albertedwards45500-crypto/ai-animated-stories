APP_ENV=development

# 可选：本地自包含 Mock 模式使用 SQLite；留空则使用下方 MySQL 配置。
# DATABASE_URL=sqlite:///./ai_drama_dev.db

# 数据库（MySQL 8.x，utf8mb4）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=ai_drama
MYSQL_USER=root
MYSQL_PASSWORD=change_me_dev

# Redis（Dramatiq broker）
REDIS_URL=redis://127.0.0.1:6379/0

# redis / thread（thread 仅适合单进程本地 Mock，不需要 Redis/Worker）
# BROKER_KIND=thread

# AI Provider 模式：mock / record / replay
AI_MODE=mock
# 可选：success/fail/timeout；留空时按请求参数确定性模拟
# MOCK_DEFAULT_SCENARIO=success
TEXT_PROVIDER=mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
AUDIO_PROVIDER=mock

# 媒体根目录
MEDIA_ROOT=./media

# FFmpeg 可执行文件（留空则使用 PATH 中的 ffmpeg）
FFMPEG_PATH=

# 真实 Provider API Key（变量名与 provider_configs.api_key_ref 对应，实际值只写入本地 .env）
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY_IMAGE=
# DASHSCOPE_API_KEY_VIDEO=
# DASHSCOPE_API_KEY_AUDIO=
# IMAGE_MODEL=qwen-image-3.0
# VIDEO_MODEL=wan3.0-video
# AUDIO_MODEL=cosyvoice-v3.5-plus
